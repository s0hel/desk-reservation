# ---- API ----
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://deskflow_app:deskflow@localhost:5432/deskflow
MIGRATION_DATABASE_URL=postgresql+psycopg://deskflow_owner:deskflow@localhost:5432/deskflow
REDIS_URL=redis://localhost:6379/0

# The test suite NEVER uses the databases above. It derives "<name>_test" from them and
# drops and recreates that database on every run, so each run starts empty. Set these
# only to override the derived names; the suite refuses to run if either resolves back
# to the development database.
# TEST_DATABASE_URL=postgresql+asyncpg://deskflow_app:deskflow@localhost:5432/deskflow_test
# TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://deskflow_owner:deskflow@localhost:5432/deskflow_test

# 32+ random bytes. Generate: openssl rand -hex 32
JWT_SIGNING_KEY=dev-only-insecure-change-me-0000000000000000000000000000000000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Public base URL of this API. Three jobs: the OIDC redirect_uri, the JWT issuer, and
# the prefix of every image URL the API hands out (floor plans and site photos), which
# are fetched by <Image> tags and so cannot be relative.
#
# That last one is why `localhost` breaks on anything that is not this machine: on an
# Android emulator or a physical phone, localhost is the DEVICE. Bookings keep working
# — the app has its own EXPO_PUBLIC_API_BASE_URL — and only the pictures silently fail
# to load, which reads as a broken image rather than a broken address. Set it to the
# Mac's LAN address (`ipconfig getifaddr en0`) whenever you are testing on either.
# Changing it also changes the JWT issuer, so existing access tokens stop verifying:
# sign in again after you change it.
API_BASE_URL=http://localhost:8000
# Deep link the app is returned to after sign-in
APP_REDIRECT_URI=deskflow://auth/callback

# DEV ONLY. Must be false outside development; startup asserts this.
ENABLE_DEV_LOGIN=true

# ---- Mobile (apps/mobile/.env) ----
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
