{
  "expo": {
    "name": "Deskflow",
    "slug": "deskflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deskflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.deskflow.app",
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the QR code on a desk or room to check in.",
        "NSLocationWhenInUseUsageDescription": "Confirm you have arrived at the office so your desk is not released.",
        "NSFaceIDUsageDescription": "Unlock Deskflow."
      }
    },
    "android": {
      "package": "com.deskflow.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": { "output": "static", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-splash-screen", {
        "backgroundColor": "#208AEF",
        "image": "./assets/images/splash-icon.png",
        "imageWidth": 76
      }]
    ],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
